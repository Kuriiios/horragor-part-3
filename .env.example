# HorRAGor application secrets. Compose mounts these as /run/secrets files.
# Generate strong unique values before starting Compose.
HORRAGOR_DATA_API_KEY=replace-with-32-random-bytes
HORRAGOR_JWT_SECRET=replace-with-at-least-32-random-bytes
# Argon2 hash generated with: uv run python -m src.auth.cli hash-password
# Keep this value single-quoted in .env so dollar signs remain literal.
HORRAGOR_AUTH_PASSWORD_HASH='replace-with-argon2id-hash'
HORRAGOR_AUTH_USERNAME=horragor
HORRAGOR_MAX_REQUEST_BODY_BYTES=131072

# Optional local model and Langfuse project credentials.
HORRAGOR_LLM_DEVICE=CPU
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Self-hosted Langfuse v4 secrets. Generate a distinct value for every field.
LANGFUSE_SALT=replace-with-random-value
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-characters
LANGFUSE_NEXTAUTH_SECRET=replace-with-random-value
LANGFUSE_POSTGRES_PASSWORD=replace-with-random-value
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-random-value
LANGFUSE_REDIS_PASSWORD=replace-with-random-value
LANGFUSE_MINIO_PASSWORD=replace-with-random-value

# Grafana administrator account.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-value