{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (service) (rate(horragor_http_requests_total[5m]))", "legendFormat": "{{service}}"}],
      "title": "Requests per second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(horragor_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(horragor_http_requests_total[5m])), 0.001)", "legendFormat": "error rate"}],
      "title": "HTTP error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, service) (rate(horragor_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{service}}"}],
      "title": "Request latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (route, narration_mode) (increase(horragor_graph_routes_total[1h]))", "legendFormat": "{{route}} / {{narration_mode}}"}],
      "title": "Graph routes (1 hour)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"expr": "sum by (generation, direction) (increase(horragor_llm_tokens_total[1h]))", "legendFormat": "{{generation}} {{direction}}"}],
      "title": "LLM tokens (1 hour)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "targets": [{"expr": "sum by (tool, outcome) (increase(horragor_tool_calls_total[1h]))", "legendFormat": "{{tool}} {{outcome}}"}],
      "title": "Tool outcomes (1 hour)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 24},
      "id": 7,
      "targets": [{"expr": "min by (instance) (probe_success)", "legendFormat": "{{instance}}"}],
      "title": "Component availability",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["horragor"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "title": "HorRAGor Overview",
  "uid": "horragor-overview",
  "version": 1
}